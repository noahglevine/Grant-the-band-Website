---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ClipFacade from '../components/ClipFacade.astro';
import BookingEmail from '../components/BookingEmail.astro';
import BookingForm from '../components/BookingForm.astro';
import Footer from '../components/Footer.astro';
import { clips, book, venuesPlayed } from '../data/site';

const ph = (label: string) => `<span class="ph-inline">[${label}]</span>`;
const formats = [
  {
    name: 'Full band with horns',
    line: `${book.fullBandPieces ?? ph('Number')}-piece. Built for clubs, residencies and outdoor nights.`,
  },
  { name: 'Trio', line: book.trioBestFor ?? ph('What the trio is best for') },
  { name: 'Duo', line: book.duoBestFor ?? ph('What the duo is best for') },
];
---

<Base
  title="Book GRANT the band | Live Band for Venues and Private Events, Long Island"
  description="Book GRANT the band for your venue or private event. Full band with horns, a trio or a duo. Originals off Meroke Lane plus the covers people came for."
  ogImage="/og/book.png"
>
  <Header newsletterHref="/#newsletter" />
  <main>
    <section class="section intro">
      <div class="wrap">
        <h1 class="display h1 title">Booking.</h1>
        <p class="lede">
          Indie rock with a horn section from Long Island. Originals off Meroke Lane plus the covers people came for. Two summers as the residency band at Cooper Bluff, plus The Stephen Talkhouse, 89 North, Piquet Lane, The Villager and Nag’s Head Ale House.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="#contact">Contact</a>
          <a class="btn btn--secondary" href="#watch">Watch first</a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="formats-title">
      <div class="wrap">
        <h2 id="formats-title" class="display h2 title head">Formats</h2>
        <ul class="formats">
          {formats.map((f) => (
            <li>
              <h3>{f.name}</h3>
              <p set:html={f.line} />
            </li>
          ))}
        </ul>
        <dl class="specs">
          <div>
            <dt>Set lengths</dt>
            <dd>{book.setLengths ?? <span class="ph-inline">[Set lengths]</span>}</dd>
          </div>
          <div>
            <dt>PA and stage</dt>
            <dd>{book.stageNeeds ?? <span class="ph-inline">[PA and stage needs]</span>}</dd>
          </div>
          <div>
            <dt>Stage plot and tech rider</dt>
            <dd>
              {book.stagePlotPdf ? (
                <a href={book.stagePlotPdf}>Download the PDF</a>
              ) : (
                <span class="ph-inline">[Stage plot + tech rider PDF, phase 2]</span>
              )}
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section id="watch" class="section" aria-labelledby="watch-title">
      <div class="wrap">
        <h2 id="watch-title" class="display h2 title head">Watch first</h2>
        <div class="clips">
          {clips.map((clip) => <ClipFacade clip={clip} />)}
        </div>
      </div>
    </section>

    <section class="section" aria-label="Played and press">
      <div class="wrap record">
        <div>
          <h2 class="display h2 title head">Played</h2>
          <ul class="played">
            {venuesPlayed.map((v) => <li>{v}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="display h2 title head">Press</h2>
          <figure class="quote">
            <blockquote>
              <p>“Everyone is executing their instrument… top shelf.”</p>
            </blockquote>
            <figcaption>Torvik, reviewing “Man on a Train”</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="contact" class="section" aria-labelledby="contact-title">
      <div class="wrap contact">
        <div>
          <h2 id="contact-title" class="display h2 title head">Contact</h2>
          <p class="lede">
            Email <BookingEmail /> with the date, the room and your budget. We answer within a day.
          </p>
        </div>
        <BookingForm />
      </div>
    </section>

  </main>
  <Footer />
</Base>

<style>
  .intro {
    padding-top: 56px;
  }
  h1 {
    max-width: 12ch;
    margin-bottom: 24px;
  }
  .intro .lede {
    margin-bottom: 28px;
  }
  .head {
    margin-bottom: 32px;
  }
  .formats {
    display: grid;
    margin: 0 0 40px;
    padding: 0;
    list-style: none;
  }
  .formats li {
    padding-block: 20px;
    border-top: 1px solid var(--hairline);
  }
  .formats li:last-child {
    border-bottom: 1px solid var(--hairline);
  }
  .formats h3 {
    font-family: var(--display);
    font-size: var(--fs-row);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .formats p {
    margin: 8px 0 0;
    color: var(--gold);
    font-size: var(--fs-small);
  }
  .specs {
    display: grid;
    gap: 20px;
    margin: 0;
  }
  dt {
    color: var(--gold);
    font-size: var(--fs-min);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  dd {
    margin: 4px 0 0;
    color: var(--cream);
  }
  .clips {
    display: grid;
    gap: 32px;
  }
  .record {
    display: grid;
    gap: 56px;
  }
  .played {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .played li {
    padding-block: 14px;
    border-top: 1px solid var(--hairline);
    color: var(--cream);
    font-size: var(--fs-row);
    line-height: 1.25;
  }
  .played li:last-child {
    border-bottom: 1px solid var(--hairline);
  }
  .quote {
    margin: 0;
    padding-left: 20px;
    border-left: 2px solid var(--amber);
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    margin: 0 0 10px;
    color: var(--cream);
    font-size: clamp(24px, 4vw, 34px);
    line-height: 1.3;
  }
  figcaption {
    color: var(--gold);
    font-size: var(--fs-small);
  }
  .contact {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 720px) {
    .formats {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .formats li,
    .formats li:last-child {
      border-bottom: 1px solid var(--hairline);
    }
    .specs {
      grid-template-columns: repeat(3, 1fr);
    }
    .clips {
      grid-template-columns: repeat(2, 1fr);
    }
    .clips > :global(:first-child) {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 900px) {
    .record {
      grid-template-columns: 1fr 1fr;
      gap: 72px;
    }
  }
  @media (min-width: 960px) {
    .contact {
      grid-template-columns: 5fr 6fr;
      gap: 72px;
    }
  }
</style>
