---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TicketList from '../components/TicketList.astro';
import Music from '../components/Music.astro';
import Video from '../components/Video.astro';
import FeatureStrip from '../components/FeatureStrip.astro';
import ShopRow from '../components/ShopRow.astro';
import Signup from '../components/Signup.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, links, ep } from '../data/site';
import { upcomingShows, showsJsonLd } from '../lib/shows';

const shows = upcomingShows();

const musicGroup = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'GRANT the band',
  url: SITE_URL,
  genre: ['Indie rock'],
  foundingLocation: { '@type': 'Place', name: 'Long Island, NY' },
  sameAs: [links.spotify, links.youtube, links.instagram, links.facebook, links.tiktok],
  album: {
    '@type': 'MusicAlbum',
    name: ep.title,
    albumReleaseType: 'https://schema.org/EPRelease',
  },
};

const jsonLd = [musicGroup, ...showsJsonLd(shows, SITE_URL)];
---

<Base
  title="GRANT the band | Indie Rock from Long Island, NY"
  description="GRANT the band. Meroke Lane out everywhere. Listen, watch, and get show dates."
  ogImage="/og/home.png"
  jsonLd={jsonLd}
>
  <Header home />
  <main>
    <Hero />

    {shows.length > 0 && (
      <section id="shows" class="section" aria-labelledby="shows-title">
        <div class="wrap">
          <h2 id="shows-title" class="display h2 title section-head">Next stop.</h2>
          <TicketList shows={shows} swipe />
          <p class="more" data-avoid-to-top>
            <a href="#newsletter">Get the dates first</a>
          </p>
        </div>
      </section>
    )}

    <Music />
    <ShopRow />
    <Video />
    <FeatureStrip />
    <Signup />
  </main>
  <Footer />
</Base>

<style>
  /* "Get the dates first": quiet gold text link, 44px tall. */
  .more {
    margin: 24px 0 0;
    max-width: none;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--gold);
    font-weight: 500;
    text-underline-offset: 4px;
  }
</style>
