---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import TicketList from '../components/TicketList.astro';
import BookingEmail from '../components/BookingEmail.astro';
import Signup from '../components/Signup.astro';
import now from '../data/now.json';
import { links, shopUrl, bookingEmail } from '../data/site';
import { upcomingShows } from '../lib/shows';
import { withUtm, BIO_UTM } from '../lib/utm';
import { showPlaceholders } from '../lib/env';

const next = upcomingShows()[0];
const hasCard = Boolean(now.title && now.url);
// Production omits the card until now.json is filled; previews show what's owed.
const showCard = hasCard || showPlaceholders;
const poster = now.poster || null;
---

<Base
  title="GRANT the band | Now"
  description="GRANT the band. The latest clip, the next show, and where to listen."
  ogImage="/og/now.png"
>
  <main class="now">
    <header class="top">
      <h1 class="visually-hidden">GRANT the band</h1>
      <Wordmark size="lg" />
      <p class="tag label">Meroke Lane · Out everywhere</p>
    </header>

    {showCard && (
      <section class="card" aria-label="The one you just watched">
        <span class="label">The one you just watched</span>
        {hasCard ? (
          <div class="card-body">
            {/* The poster is a second way into the same Reel; the text link below is the one
                screen readers and the keyboard use. */}
            <a class="card-media" href={withUtm(now.url)} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
              {poster ? (
                <img src={poster} alt="" width="1080" height="1350" decoding="async" />
              ) : (
                showPlaceholders && <div class="ph poster">[Poster image]</div>
              )}
              <span class="play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
              </span>
            </a>
            <span class="card-title">{now.title}</span>
            <a class="card-watch" href={withUtm(now.url)} target="_blank" rel="noopener">Watch on Instagram<span class="visually-hidden">: {now.title} (opens in a new tab)</span></a>
          </div>
        ) : (
          <div class="ph poster">[now.json: title, url, poster from the latest Instagram post]</div>
        )}
      </section>
    )}

    {next && (
      <section class="next" aria-label="Next show">
        <span class="label">Next stop</span>
        <TicketList shows={[next]} utm={BIO_UTM} />
      </section>
    )}

    <nav class="links" aria-label="Links">
      <a class="btn btn--primary" href="#newsletter">Get show dates</a>
      <a class="btn btn--secondary" href={withUtm(links.merokeLaneSpotify)} rel="noopener">Listen to Meroke Lane</a>
      <a class="btn btn--secondary" href={withUtm(shopUrl)} rel="noopener">Merch</a>
      <a class="btn btn--secondary" href="/#live">Watch us live</a>
      <a class="btn btn--secondary" href="/book">Book us</a>
    </nav>

    <Signup variant="compact" />

    <footer class="foot" data-page-end>
      {bookingEmail && <p class="booking">Contact: <BookingEmail /></p>}
      <a href="/">granttheband.com</a>
    </footer>
  </main>
</Base>

<style>
  .now {
    max-width: 480px;
    margin-inline: auto;
    padding: 40px var(--gutter) 32px;
    display: grid;
    gap: 28px;
  }
  .top {
    display: grid;
    justify-items: center;
    gap: 10px;
    text-align: center;
  }
  .tag {
    margin: 0;
  }
  .card {
    display: grid;
    gap: 10px;
  }
  .card-body {
    display: grid;
    gap: 12px;
  }
  .card-media {
    position: relative;
    display: block;
    text-decoration: none;
  }
  /* Same play button as the Live clips, centered on the poster. */
  .card-media .play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--night);
    transform: translate(-50%, -50%);
  }
  .card-media:hover .play {
    background: var(--cream);
  }
  .card-watch {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: 44px;
    margin-top: -8px;
    color: var(--gold);
    font-weight: 500;
    text-underline-offset: 4px;
  }
  .card-media img,
  .poster {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* Taller posters (like the 9:16 hero still) crop a little high: keeps the jump, drops the stage floor. 4:5 posters are unaffected. */
    object-position: 50% 25%;
    border-radius: 12px;
  }
  .card-title {
    color: var(--cream);
    font-size: var(--fs-row);
  }
  .label {
    margin-bottom: 4px;
  }
  .links {
    display: grid;
    gap: 12px;
  }
  .links .btn {
    width: 100%;
  }
  .now :global(.signup.compact) {
    scroll-margin-top: 16px;
  }
  .foot {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding-top: 8px;
    font-size: var(--fs-small);
  }
  .booking {
    margin: 0;
    color: var(--cream);
  }
  .booking :global(a) {
    color: var(--gold);
    font-weight: 500;
  }
  .foot a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--gold);
    font-weight: 500;
    text-decoration: none;
  }
</style>
