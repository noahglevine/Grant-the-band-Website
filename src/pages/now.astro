---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import ShowRow from '../components/ShowRow.astro';
import Signup from '../components/Signup.astro';
import now from '../data/now.json';
import { links } from '../data/site';
import { upcomingShows } from '../lib/shows';
import { withUtm, BIO_UTM } from '../lib/utm';

const next = upcomingShows()[0];
const hasCard = Boolean(now.title && now.url);
---

<Base
  title="GRANT the band | Now"
  description="Indie rock from Long Island. Better in the room. The latest clip, the next show, and where to listen."
  ogImage="/og/now.png"
>
  <main class="now">
    <header class="top">
      <Wordmark size="lg" />
      <p class="tag">Indie rock from Long Island. Better in the room.</p>
    </header>

    <section class="card" aria-label="The one you just watched">
      <span class="aside">The one you just watched</span>
      {hasCard ? (
        <a class="card-link" href={withUtm(now.url)} rel="noopener">
          {now.poster ? (
            <img src={now.poster} alt="" width="1080" height="1350" decoding="async" />
          ) : (
            <div class="ph poster">[Poster image]</div>
          )}
          <span class="card-title">{now.title}</span>
        </a>
      ) : (
        <div class="ph poster">[now.json: title, url, poster from the latest Instagram post]</div>
      )}
    </section>

    {next && (
      <section class="next" aria-label="Next show">
        <span class="label">Next show</span>
        <ul>
          <ShowRow show={next} utm={BIO_UTM} />
        </ul>
      </section>
    )}

    <nav class="links" aria-label="Links">
      <a class="btn btn--primary" href="#signup">Get show dates</a>
      <a class="btn btn--secondary" href={withUtm(links.spotify)} rel="noopener">Listen to Meroke Lane</a>
      <a class="btn btn--secondary" href="/#live">Watch us live</a>
      <a class="btn btn--secondary" href="/book">Book us</a>
    </nav>

    <Signup compact />

    <footer class="foot">
      <a href="/">granttheband.com</a>
    </footer>
  </main>
</Base>

<style>
  .now {
    max-width: 480px;
    margin-inline: auto;
    padding: 40px var(--gutter) 32px;
    display: grid;
    gap: 28px;
  }
  .top {
    display: grid;
    justify-items: center;
    gap: 10px;
    text-align: center;
  }
  .tag {
    margin: 0;
    color: var(--body);
  }
  .card {
    display: grid;
    gap: 10px;
  }
  .card .aside {
    font-size: 1.5rem;
  }
  .card-link {
    display: grid;
    gap: 12px;
    text-decoration: none;
  }
  .card-link img,
  .poster {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 12px;
  }
  .card-title {
    color: var(--text);
    font-size: 1.125rem;
    font-weight: 700;
  }
  .next ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  .label {
    display: block;
    margin-bottom: 4px;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .links {
    display: grid;
    gap: 12px;
  }
  .links .btn {
    width: 100%;
  }
  .now :global(.signup.compact) {
    scroll-margin-top: 16px;
  }
  .foot {
    text-align: center;
    padding-top: 8px;
  }
  .foot a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font-weight: 600;
    text-decoration: none;
  }
</style>
