---
import ShowRow from './ShowRow.astro';
import type { Show } from '../lib/shows';

interface Props {
  shows: Show[];
}
const { shows } = Astro.props;
---

<ul class="show-list">
  {shows.map((show) => <ShowRow show={show} />)}
</ul>

<style>
  .show-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
</style>
