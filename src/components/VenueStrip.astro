---
import { venuesPlayed } from '../data/site';
---

<section class="strip" aria-label="Rooms we’ve played">
  <div class="wrap row">
    <span class="aside">Rooms we’ve played</span>
    <ul>
      {venuesPlayed.map((v) => <li>{v}</li>)}
    </ul>
  </div>
</section>

<style>
  .strip {
    border-block: 1px solid var(--line);
    background: var(--surface);
    padding-block: 22px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
  }
  /* Phones: one room per line. Wider screens: a single dotted row. */
  ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    color: var(--text);
    font-size: var(--fs-min);
    font-weight: 700;
    font-stretch: 115%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (min-width: 720px) {
    ul {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 0;
    }
    li {
      white-space: nowrap;
    }
    li:not(:last-child)::after {
      content: '·';
      margin-inline: 0.7em;
      color: var(--accent);
    }
  }
</style>
