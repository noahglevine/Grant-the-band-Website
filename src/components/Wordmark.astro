---
// The only place the wordmark is drawn. Header, footer, /now and the home hero all use this.
// Small sizes: "GRANT THE BAND" in display caps. Hero: "GRANT" large with "the band"
// handwritten in Reenie Beanie (the one handwritten line on that screen).
import { wordmarkSvg } from '../data/site';

interface Props {
  size?: 'md' | 'lg' | 'hero';
  // Pass null to render without a link (the home hero, where it's the H1).
  href?: string | null;
}
const { size = 'md', href = '/' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  class:list={['wordmark', `wordmark--${size}`]}
  href={href ?? undefined}
  aria-label={href ? 'GRANT the band, home' : undefined}
>
  {wordmarkSvg ? (
    <img class="wm-logo" src={wordmarkSvg} alt="GRANT the band" />
  ) : size === 'hero' ? (
    <>
      <span class="wm-grant">GRANT</span>{' '}<span class="wm-band">the band</span>
    </>
  ) : (
    <span class="wm-small">GRANT the band</span>
  )}
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
    color: var(--cream);
  }
  .wm-small {
    font-family: var(--display);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .wm-logo {
    display: block;
    height: 1.3em;
    width: auto;
  }
  .wordmark--md {
    font-size: 17px;
  }
  .wordmark--lg {
    font-size: 20px;
  }

  /* Hero lockup: GRANT wide and centered, "the band" handwritten under the right edge.
     At least 90px tall on phones, 140px on desktop. */
  /* Hero lockup. GRANT is ~3.9em wide. Phones: at most 70vw wide (15vw is ~58vw), and capped
     by height so the hero content stays under the jump. Desktop (900px+): at most 30vw wide. */
  .wordmark--hero {
    flex-direction: column;
    align-items: flex-end;
    font-size: min(15vw, 9svh);
  }
  .wm-grant {
    font-family: var(--display);
    font-weight: 400;
    letter-spacing: 0.06em;
    margin-right: -0.06em; /* trailing tracking */
    line-height: 0.9;
  }
  .wm-band {
    font-family: var(--script);
    font-weight: 400;
    font-size: 0.42em;
    line-height: 1;
    color: var(--gold);
  }
  .wordmark--hero .wm-logo {
    height: auto;
    width: min(58vw, 35svh);
  }
  @media (min-width: 900px) {
    .wordmark--hero {
      font-size: 7.6vw;
    }
    .wordmark--hero .wm-logo {
      width: 30vw;
    }
  }
</style>
