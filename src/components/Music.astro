---
import ListenButton from './ListenButton.astro';
import { ep, links, srcset } from '../data/site';
import { showPlaceholders } from '../lib/env';

// "Listen" is Spotify; these are the other places to hear it.
const platforms = [
  { label: 'Apple Music', href: links.appleMusic },
  { label: 'YouTube', href: links.merokeLaneYoutube ?? links.youtube },
].filter((p) => p.href || showPlaceholders);
---

<section id="music" class="section" aria-labelledby="music-title">
  <div class="wrap grid">
    <div class="cover">
      {ep.cover ? (
        <img
          src={ep.cover.src}
          srcset={srcset(ep.cover)}
          sizes="(min-width: 900px) 45vw, 100vw"
          width={ep.cover.width}
          height={ep.cover.height}
          alt={ep.cover.alt}
          loading="lazy"
          decoding="async"
        />
      ) : (
        showPlaceholders && <div class="ph cover-ph">[Meroke Lane cover art]</div>
      )}
    </div>

    <div class="copy">
      <h2 id="music-title" class="display h2 title">Meroke Lane</h2>
      <!-- The tracklist is the fallback: it shows with JS off, and stays if the Spotify player
           can't load. With JS, the player is injected once the section is ~400px away. -->
      <div class="listen-slot" data-embed={links.merokeLaneEmbed}>
        <ol class="songs" aria-label="Tracklist">
          {ep.tracks.map((track) => <li>“{track}”</li>)}
        </ol>
      </div>

      <ListenButton />

      <ul class="platforms" aria-label="Also on">
        {platforms.map((p) => (
          <li>
            {p.href ? (
              <a href={p.href} rel="noopener">{p.label}</a>
            ) : (
              <span>{p.label} <span class="ph-inline">[URL]</span></span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const slot = document.querySelector<HTMLElement>('.listen-slot[data-embed]');
  const src = slot?.dataset.embed;
  if (slot && src && 'IntersectionObserver' in window) {
    // Reserve the player's height up front so nothing shifts when it swaps in.
    slot.classList.add('is-pending');
    const giveUp = () => {
      slot.querySelector('iframe')?.remove();
      slot.classList.remove('is-pending');
    };
    const load = async () => {
      // An iframe fires "load" even on an error page, so check Spotify is reachable first
      // (offline, blocked by a network or a content blocker).
      try {
        await fetch(src, { method: 'HEAD', mode: 'no-cors' });
      } catch {
        return giveUp();
      }
      const frame = document.createElement('iframe');
      frame.src = src;
      frame.title = 'Listen to Meroke Lane on Spotify';
      frame.loading = 'lazy';
      frame.width = '100%';
      frame.height = '352';
      frame.allow = 'clipboard-write; encrypted-media; fullscreen; picture-in-picture';
      const timer = setTimeout(giveUp, 10000);
      frame.addEventListener('load', () => {
        clearTimeout(timer);
        slot.classList.add('is-embedded');
      }, { once: true });
      slot.append(frame);
    };
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        load();
      }
    }, { rootMargin: '400px 0px' });
    io.observe(slot);
  }
</script>

<style>
  .grid {
    display: grid;
    gap: 40px;
  }
  .cover img,
  .cover-ph {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .listen-slot {
    position: relative;
    margin: 24px 0 32px;
  }
  .listen-slot.is-pending {
    min-height: 352px;
  }
  /* The player waits invisibly on top of the reserved space until it has loaded. */
  .listen-slot :global(iframe) {
    position: absolute;
    inset: 0 0 auto;
    display: block;
    width: 100%;
    height: 352px;
    border: 0;
    border-radius: 12px;
    opacity: 0;
    pointer-events: none;
  }
  .listen-slot.is-embedded :global(iframe) {
    position: static;
    opacity: 1;
    pointer-events: auto;
  }
  .listen-slot.is-embedded .songs {
    display: none;
  }
  .songs {
    margin: 0;
    padding-left: 1.6em;
    list-style: decimal;
  }
  .songs li {
    color: var(--cream);
    line-height: 1.8;
    padding-left: 0.3em;
  }
  .songs li::marker {
    color: var(--gold);
    font-size: var(--fs-small);
  }
  .platforms {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
  }
  .platforms li:not(:last-child)::after {
    content: '·';
    margin-inline: 10px;
    color: var(--gold);
  }
  .platforms a,
  .platforms li > span {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    color: var(--gold);
    text-underline-offset: 4px;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 5fr 6fr;
      gap: 72px;
      align-items: center;
    }
  }
</style>
