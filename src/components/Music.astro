---
import ListenButton from './ListenButton.astro';
import { ep, links } from '../data/site';
---

<section id="music" class="section" aria-labelledby="music-title">
  <div class="wrap grid">
    <div class="cover">
      {ep.cover ? (
        <img src={ep.cover} alt="Meroke Lane cover art" width="800" height="800" loading="lazy" decoding="async" />
      ) : (
        <div class="ph cover-ph">[Meroke Lane cover art]</div>
      )}
    </div>

    <div class="copy">
      <h2 id="music-title" class="display h2 title">Music</h2>
      <p class="sub">Off our EP, Meroke Lane. Out everywhere.</p>

      <div class="btn-row">
        <ListenButton />
        <a class="btn btn--secondary" href={links.spotify} rel="noopener">Spotify</a>
        {links.appleMusic ? (
          <a class="btn btn--secondary" href={links.appleMusic} rel="noopener">Apple Music</a>
        ) : (
          <span class="btn btn--secondary ph-btn" aria-disabled="true">Apple Music <span class="ph-inline">[URL]</span></span>
        )}
        <a class="btn btn--secondary" href={links.merokeLaneYoutube ?? links.youtube} rel="noopener">YouTube</a>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 40px;
  }
  .copy .btn-row {
    margin-top: 32px;
  }
  .cover img,
  .cover-ph {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 5fr 6fr;
      gap: 72px;
      align-items: center;
    }
  }
</style>
