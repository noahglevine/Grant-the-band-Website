---
import ListenButton from './ListenButton.astro';
import { ep, links } from '../data/site';

const platforms = [
  { label: 'Spotify', href: links.spotify },
  { label: 'Apple Music', href: links.appleMusic },
  { label: 'YouTube', href: links.merokeLaneYoutube ?? links.youtube },
];
---

<section id="music" class="section" aria-labelledby="music-title">
  <div class="wrap grid">
    <div class="cover">
      {ep.cover ? (
        <img src={ep.cover} alt="Meroke Lane cover art" width="800" height="800" loading="lazy" decoding="async" />
      ) : (
        <div class="ph cover-ph">[Meroke Lane cover art]</div>
      )}
    </div>

    <div class="copy">
      <h2 id="music-title" class="display h2 title">Meroke Lane</h2>
      <p class="sub">Off our EP, Meroke Lane. Out everywhere.</p>

      <ul class="songs" aria-label="Songs">
        {ep.songs.map((song) => <li>“{song}”</li>)}
      </ul>

      <ListenButton />

      <ul class="platforms" aria-label="Also on">
        {platforms.map((p) => (
          <li>
            {p.href ? (
              <a href={p.href} rel="noopener">{p.label}</a>
            ) : (
              <span>{p.label} <span class="ph-inline">[URL]</span></span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 40px;
  }
  .cover img,
  .cover-ph {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .songs {
    margin: 24px 0 32px;
    padding: 0;
    list-style: none;
  }
  .songs li {
    color: var(--cream);
    line-height: 1.8;
  }
  .platforms {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
  }
  .platforms li:not(:last-child)::after {
    content: '·';
    margin-inline: 10px;
    color: var(--gold);
  }
  .platforms a,
  .platforms li > span {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    color: var(--gold);
    text-underline-offset: 4px;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 5fr 6fr;
      gap: 72px;
      align-items: center;
    }
  }
</style>
