---
// Placeholder until Noah picks Kit or MailerLite. When that lands, swap the <form>
// action/fields for the provider's embed and delete the submit handler below.
interface Props {
  id?: string;
  // band: full section with title (home, /shows). compact: same, sized for /now's column.
  // inline: just the line and the form, no title (/shows empty state).
  variant?: 'band' | 'compact' | 'inline';
  line?: string;
}
const { id = 'newsletter', variant = 'band', line = 'New music and show dates, before anyone else.' } = Astro.props;
const titleId = `${id}-title`;
---

{variant === 'inline' ? (
  <div id={id} class="signup signup--inline">
    <p class="sub line">{line}</p>
    <form class="form" data-signup-placeholder novalidate>
      <label class="visually-hidden" for={`${id}-email`}>Email address</label>
      <input id={`${id}-email`} class="input" type="email" name="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required />
      <button class="btn btn--primary" type="submit">Sign up</button>
      <p class="status" role="status" aria-live="polite"></p>
      <p class="ph-tag">[Email provider: Kit or MailerLite, not connected yet]</p>
    </form>
  </div>
) : (
  <section id={id} class:list={['signup', 'section', { compact: variant === 'compact' }]} aria-labelledby={titleId}>
    <div class="wrap inner">
      <div class="copy">
        <h2 id={titleId} class="display h2 title">First to know.</h2>
        <p class="sub">{line}</p>
      </div>
      <form class="form" data-signup-placeholder novalidate>
        <label class="visually-hidden" for={`${id}-email`}>Email address</label>
        <input id={`${id}-email`} class="input" type="email" name="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required />
        <button class="btn btn--primary" type="submit">Sign up</button>
        <p class="status" role="status" aria-live="polite"></p>
        <p class="ph-tag">[Email provider: Kit or MailerLite, not connected yet]</p>
      </form>
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-signup-placeholder]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const status = form.querySelector('.status');
      if (status) status.textContent = 'Signup isn’t connected yet. It goes live with the email provider.';
    });
  });
</script>

<style>
  .form {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .status {
    margin: 0;
    color: var(--cream);
  }
  .status:empty {
    display: none;
  }
  .ph-tag {
    margin: 0;
    color: var(--gold);
    font-size: var(--fs-min);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  @media (min-width: 480px) {
    .form {
      grid-template-columns: 1fr auto;
    }
    .status,
    .ph-tag {
      grid-column: 1 / -1;
    }
  }

  .inner {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .signup:not(.compact) .inner {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: end;
    }
  }

  /* /now: sits inside a 480px column. */
  .compact {
    padding-block: 40px;
  }
  .compact .wrap {
    padding-inline: 0;
  }
  .compact .form {
    grid-template-columns: 1fr;
  }

  .signup--inline {
    max-width: 640px;
  }
  .signup--inline .line {
    margin: 0 0 16px;
  }
</style>
