---
import fs from 'node:fs';
import path from 'node:path';
import Wordmark from './Wordmark.astro';
import ListenButton from './ListenButton.astro';
import { hero, links } from '../data/site';
import { showPlaceholders } from '../lib/env';

// Use each loop only if its file is in public/. Until then the posters carry the hero.
const exists = (p: string) => fs.existsSync(path.join(process.cwd(), 'public', p));
const videoDesktop = exists(hero.videoDesktop) ? hero.videoDesktop : null;
const videoPhone = exists(hero.videoPhone) ? hero.videoPhone : videoDesktop;
// Song excerpt: the button shows only once the MP3 exists. Previews show a placeholder until
// then; production hides it.
const song = exists(hero.song) ? hero.song : null;
const playIcon = '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>';
const desk = hero.posterDesktop;
const phone = hero.posterPhone;
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Background layer: poster photo (art-directed by orientation), the loop on top once it
       plays, and the night scrim. -->
  <div class="media">
    <picture>
      <source media="(max-aspect-ratio: 1/1)" srcset={phone.src} width={phone.width} height={phone.height} />
      <img class="fill" src={desk.src} width={desk.width} height={desk.height} alt={desk.alt} fetchpriority="high" />
    </picture>
    {videoDesktop && (
      <video
        class="fill loop"
        data-desktop={videoDesktop}
        data-phone={videoPhone}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
      />
    )}
    <div class="scrim" aria-hidden="true" />
  </div>

  <!-- Bottom-left on desktop, bottom on phones: the jump happens mid-frame and stays clear. -->
  <div class="content">
    <h1 id="hero-title" class="logo"><Wordmark size="hero" href={null} /></h1>
    <p class="release">
      <span class="label">Meroke Lane</span>
      <span class="out display">Out everywhere</span>
    </p>
    <div class="btn-row">
      <ListenButton class="hero-listen" />
      <a class="btn btn--secondary hero-shows" href="/shows">Shows</a>
    </div>
    {song ? (
      <div class="song" data-spotify={links.manOnATrainSpotify}>
        <audio src={song} preload="none" />
        <button class="song-btn" type="button"><Fragment set:html={playIcon} /><span class="song-label">Play “Man on a Train”</span></button>
      </div>
    ) : (
      showPlaceholders && (
        <div class="song">
          <span class="song-btn ph-btn" aria-disabled="true"><Fragment set:html={playIcon} />Play “Man on a Train” <span class="ph-inline">[mp3]</span></span>
        </div>
      )
    )}
  </div>
</section>

<script is:inline>
  // Play the loop only when motion and data are welcome. Reduced-motion visitors, Save-Data
  // (Data Saver / Low Data Mode) and prefers-reduced-data keep the poster and never download
  // video. Only one file is ever fetched: the vertical cut on portrait screens (phones), the
  // wide cut otherwise. The <video> has no src until this runs, so nothing preloads.
  (function () {
    var v = document.querySelector('.hero video.loop');
    var c = navigator.connection;
    if (
      !v ||
      matchMedia('(prefers-reduced-motion: reduce)').matches ||
      matchMedia('(prefers-reduced-data: reduce)').matches ||
      (c && c.saveData)
    ) return;
    var portrait = matchMedia('(max-aspect-ratio: 1/1)').matches;
    v.src = portrait ? v.dataset.phone : v.dataset.desktop;
    v.addEventListener('playing', function () { v.classList.add('is-playing'); }, { once: true });
    v.play().catch(function () {});
  })();

  // "Play “Man on a Train”": an audio excerpt over the muted loop (the loop keeps playing).
  // The MP3 is fetched only on tap. Play / Pause toggle; when the excerpt ends the control
  // becomes a link to the full song on Spotify.
  (function () {
    var wrap = document.querySelector('.hero .song[data-spotify]');
    if (!wrap) return;
    var audio = wrap.querySelector('audio');
    var btn = wrap.querySelector('.song-btn');
    var label = btn.querySelector('.song-label');
    var icon = btn.querySelector('svg path');
    var PLAY = 'M8 5v14l11-7z';
    var PAUSE = 'M7 5h4v14H7zM13 5h4v14h-4z';
    function show(playing) {
      label.textContent = playing ? 'Pause' : 'Play \u201cMan on a Train\u201d';
      icon.setAttribute('d', playing ? PAUSE : PLAY);
    }
    btn.addEventListener('click', function () {
      if (audio.paused) {
        audio.play().then(function () { show(true); }).catch(function () { show(false); });
      } else {
        audio.pause();
        show(false);
      }
    });
    audio.addEventListener('ended', function () {
      var link = document.createElement('a');
      link.className = 'song-btn';
      link.href = wrap.dataset.spotify;
      link.target = '_blank';
      link.rel = 'noopener';
      link.textContent = 'Hear the full song on Spotify';
      btn.replaceWith(link);
      link.focus();
    });
  })();
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--night);
  }
  .fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Tall phones: the vertical cut fills the height, so lift it 10% (ceiling only) to put the
     jump above the text. The strip it leaves at the bottom sits under the darkest scrim. */
  @media (max-aspect-ratio: 9/16) {
    .fill {
      transform: translateY(-10%);
    }
  }
  .loop {
    opacity: 0;
    transition: opacity 0.6s;
  }
  .loop.is-playing {
    opacity: 1;
  }
  /* Song control: its own row under Listen / Shows (the labels are too long to share it on
     phones). A 44px pill, lighter than the page buttons. */
  .song {
    margin-top: 12px;
  }
  .song-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--cream);
    border-radius: var(--radius);
    background: rgb(16 21 28 / 0.55);
    color: var(--cream);
    font: inherit;
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .song-btn.ph-btn {
    cursor: default;
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: var(--scrim);
  }
  .content {
    display: grid;
    justify-items: start;
    width: 100%;
    padding: 0 var(--gutter) max(24px, calc(env(safe-area-inset-bottom) + 16px));
  }
  .logo {
    margin: 0;
    line-height: 1;
  }
  .release {
    display: grid;
    justify-items: start;
    gap: 2px;
    margin: 14px 0 0;
    max-width: none;
  }
  .out {
    font-size: clamp(22px, 2.6vw, 40px);
  }
  .btn-row {
    margin-top: 18px;
  }
  /* Phones: no Listen in the hero (the Music section and the song pill cover listening), so
     Shows is the one primary button. Desktop keeps Listen + Shows. */
  @media (max-width: 899px) {
    .btn-row :global(.hero-listen) {
      display: none;
    }
    .hero-shows {
      background: var(--gold);
      color: var(--night);
      border-color: transparent;
    }
    .hero-shows:hover {
      background: var(--cream);
      color: var(--night);
    }
  }
  /* Short phones (iPhone SE size): tighter vertical rhythm so the extra song row doesn't push
     the text up into the jump. */
  @media (max-width: 899px) and (max-height: 720px) {
    .content {
      padding-bottom: max(16px, calc(env(safe-area-inset-bottom) + 12px));
    }
    .release {
      gap: 0;
      margin-top: 8px;
    }
    .btn-row {
      margin-top: 10px;
    }
    .song {
      margin-top: 8px;
    }
  }
  @media (min-width: 900px) {
    .scrim {
      background: var(--scrim-desktop);
    }
    .content {
      position: absolute;
      left: 6vw;
      bottom: 10vh;
      width: auto;
      padding: 0;
    }
    .release {
      gap: 6px;
      margin-top: 20px;
    }
    .btn-row {
      margin-top: 28px;
    }
  }
</style>
