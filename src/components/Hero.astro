---
import Wordmark from './Wordmark.astro';
import ListenButton from './ListenButton.astro';
import { hero } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="media">
    {hero.video ? (
      <video
        class="video"
        data-src={hero.video}
        poster={hero.poster ?? undefined}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
      />
    ) : hero.poster ? (
      <img class="video" src={hero.poster} alt="" />
    ) : (
      <div class="ph media-ph" aria-hidden="true">
        <span>[Hero video loop or photo: full band, golden hour]</span>
      </div>
    )}
    <div class="scrim" />
  </div>

  <div class="wrap content">
    <h1 id="hero-title" class="logo"><Wordmark size="hero" href={null} /></h1>
    <p class="release">
      <span class="kicker">Meroke Lane</span>
      <span class="out display">Out now</span>
    </p>
    <div class="btn-row">
      <ListenButton />
      <a class="btn btn--secondary" href="/shows">Shows</a>
    </div>
  </div>
</section>

<script is:inline>
  // Autoplay the loop only when motion is welcome. Reduced-motion visitors keep the poster
  // and never download the video.
  (function () {
    var v = document.querySelector('.hero video[data-src]');
    if (!v || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    v.src = v.dataset.src;
    v.play().catch(function () {});
  })();
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: 112px 64px;
    overflow: hidden;
    isolation: isolate;
    text-align: center;
  }
  .media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--placeholder);
  }
  .video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media-ph {
    position: absolute;
    inset: auto 0 0;
    padding: 16px var(--gutter);
    border: 0;
    border-top: 1px dashed var(--muted);
    background: transparent;
  }
  /* Flat scrim for legibility over footage. No gradients. */
  .scrim {
    position: absolute;
    inset: 0;
    background: rgb(22 18 14 / 0.4);
  }
  .content {
    display: grid;
    justify-items: center;
    gap: 28px;
  }
  .logo {
    margin: 0;
    line-height: 1;
  }
  .release {
    display: grid;
    justify-items: center;
    gap: 6px;
    margin: 0;
    max-width: none;
  }
  .kicker {
    color: var(--text);
    font-size: var(--fs-small);
    font-weight: 700;
    font-stretch: 115%;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .out {
    font-size: clamp(44px, 8vw, 88px);
  }
  .btn-row {
    justify-content: center;
  }
</style>
