---
import Wordmark from './Wordmark.astro';
import ListenButton from './ListenButton.astro';
import { hero } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="media">
    {hero.video ? (
      <video
        class="video"
        data-src={hero.video}
        poster={hero.poster ?? undefined}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
      />
    ) : hero.poster ? (
      <img class="video" src={hero.poster} alt={hero.alt} />
    ) : (
      <p class="ph-note" aria-hidden="true">[Hero video loop or photo: full band, golden hour]</p>
    )}
    {(hero.video || hero.poster) && <div class="scrim" />}
  </div>

  <div class="wrap content">
    <h1 id="hero-title" class="logo"><Wordmark size="hero" href={null} /></h1>
    <p class="release">
      <span class="label">Meroke Lane</span>
      <span class="out display">Out everywhere</span>
    </p>
    <div class="btn-row">
      <ListenButton />
      <a class="btn btn--secondary" href="/shows">Shows</a>
    </div>
  </div>
</section>

<script is:inline>
  // Autoplay the loop only when motion is welcome. Reduced-motion visitors keep the poster
  // and never download the video.
  (function () {
    var v = document.querySelector('.hero video[data-src]');
    if (!v || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    v.src = v.dataset.src;
    v.play().catch(function () {});
  })();
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: 112px 64px;
    overflow: hidden;
    isolation: isolate;
    text-align: center;
  }
  .media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--night);
  }
  .video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Night gradient scrim behind the text: night 0% to 70%. */
  .scrim {
    position: absolute;
    inset: 0;
    background: var(--scrim);
  }
  .ph-note {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    margin: 0 auto;
    padding-inline: var(--gutter);
    color: var(--gold);
    font-size: var(--fs-min);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .content {
    display: grid;
    justify-items: center;
    gap: 32px;
  }
  .logo {
    margin: 0;
    line-height: 1;
  }
  .release {
    display: grid;
    justify-items: center;
    gap: 10px;
    margin: 0;
    max-width: none;
  }
  .out {
    font-size: clamp(30px, 6vw, 64px);
  }
  .btn-row {
    justify-content: center;
  }
</style>
