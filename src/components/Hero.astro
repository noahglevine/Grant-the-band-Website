---
import Wordmark from './Wordmark.astro';
import ListenButton from './ListenButton.astro';
import { hero } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Background layer: media (or its placeholder) plus the night scrim, behind everything. -->
  <div class="media">
    {hero.video ? (
      <video
        class="video"
        data-src={hero.video}
        poster={hero.poster ?? undefined}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
      />
    ) : hero.poster ? (
      <img class="video" src={hero.poster} alt={hero.alt} />
    ) : (
      <div class="video ph-block" aria-hidden="true">
        <p class="ph-note">[Hero video loop or photo: full band, golden hour]</p>
      </div>
    )}
    <div class="scrim" aria-hidden="true" />
  </div>

  <div class="wrap content">
    <div class="center">
      <h1 id="hero-title" class="logo"><Wordmark size="hero" href={null} /></h1>
      <p class="release">
        <span class="label">Meroke Lane</span>
        <span class="out display">Out everywhere</span>
      </p>
    </div>
    <div class="btn-row">
      <ListenButton />
      <a class="btn btn--secondary" href="/shows">Shows</a>
    </div>
  </div>
</section>

<script is:inline>
  // Autoplay the loop only when motion is welcome. Reduced-motion visitors keep the poster
  // and never download the video.
  (function () {
    var v = document.querySelector('.hero video[data-src]');
    if (!v || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    v.src = v.dataset.src;
    v.play().catch(function () {});
  })();
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    text-align: center;
  }
  .media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--night);
  }
  .video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Until the footage lands: one neutral night block in the same background layer. */
  .ph-block {
    background: var(--lift);
  }
  .ph-note {
    position: absolute;
    top: 88px;
    left: 0;
    right: 0;
    margin: 0 auto;
    padding-inline: var(--gutter);
    color: var(--gold);
    font-size: var(--fs-min);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  /* Night gradient scrim: night 0% to 70%. */
  .scrim {
    position: absolute;
    inset: 0;
    background: var(--scrim);
  }
  /* Logo and release fill the space; buttons sit in the lower third. */
  .content {
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    gap: 32px;
    padding-block: 104px 12svh;
  }
  .center {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 28px;
  }
  .logo {
    margin: 0;
    line-height: 1;
  }
  .release {
    display: grid;
    justify-items: center;
    gap: 10px;
    margin: 0;
    max-width: none;
  }
  .out {
    font-size: clamp(28px, 4vw, 48px);
  }
  .btn-row {
    justify-content: center;
  }
</style>
