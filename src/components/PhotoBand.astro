---
// Full-bleed band photo. Renders nothing until the photo exists: no empty boxes as the main visual.
import { photoBand } from '../data/site';
---

{photoBand.src && (
  <section class="photo-band" aria-label="Band photo">
    <img src={photoBand.src} alt={photoBand.alt} loading="lazy" decoding="async" />
  </section>
)}

<style>
  .photo-band img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  @media (min-width: 720px) {
    .photo-band img {
      aspect-ratio: 21 / 9;
    }
  }
</style>
