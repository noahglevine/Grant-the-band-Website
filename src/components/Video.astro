---
import ClipFacade from './ClipFacade.astro';
import { clips, links } from '../data/site';
---

<section id="video" class="section" aria-labelledby="video-title">
  <div class="wrap">
    <h2 id="video-title" class="display h2 title section-head">Video</h2>
    <div class="clips">
      {clips.map((clip) => <ClipFacade clip={clip} />)}
    </div>
    <p class="more"><a href={links.youtube} rel="noopener">More on YouTube</a></p>
  </div>
</section>

<style>
  .clips {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 720px) {
    .clips {
      grid-template-columns: repeat(2, 1fr);
    }
    .clips > :global(:first-child) {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1100px) {
    .clips {
      grid-template-columns: 2fr 1fr;
      grid-template-rows: auto auto;
    }
    .clips > :global(:first-child) {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
  }
  .more {
    margin: 32px 0 0;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--gold);
    font-weight: 500;
    text-underline-offset: 4px;
  }
</style>
