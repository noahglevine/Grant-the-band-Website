---
// Home: three products from the merch store, read at build time (src/lib/shop.ts). If the store
// can't be read, the section renders nothing. Images load lazily from Shopify's CDN.
import { shopUrl } from '../data/site';
import { shopProducts, shopImage } from '../lib/shop';

const products = await shopProducts();
---

{products.length > 0 && (
  <section id="shop" class="section" aria-labelledby="shop-title">
    <div class="wrap">
      <h2 id="shop-title" class="display h2 title section-head">Shop</h2>
      <ul class="products">
        {products.map((p) => (
          <li>
            <a class="product" href={p.url} rel="noopener">
              {p.image && (
                <img
                  src={shopImage(p.image, 600)}
                  srcset={`${shopImage(p.image, 400)} 400w, ${shopImage(p.image, 600)} 600w, ${shopImage(p.image, 900)} 900w`}
                  sizes="(min-width: 900px) 30vw, 62vw"
                  width="600"
                  height="600"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="name">{p.title}</span>
              <span class="price">{p.price}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="more"><a href={shopUrl} rel="noopener">Shop all</a></p>
    </div>
  </section>
)}

<style>
  /* Phones: a sideways row (the next product peeking in). 720px+: three across. */
  .products {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 62%;
    gap: 16px;
    margin: 0 calc(-1 * var(--gutter));
    padding: 0 var(--gutter) 4px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .products::-webkit-scrollbar {
    display: none;
  }
  .products li {
    scroll-snap-align: start;
  }
  @media (min-width: 720px) {
    .products {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
  }
  .product {
    display: grid;
    gap: 4px;
    color: var(--cream);
    text-decoration: none;
  }
  .product img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: 10px;
    border-radius: 12px;
    background: var(--lift);
  }
  .name {
    font-size: var(--fs-row);
    line-height: 1.3;
  }
  .product:hover .name {
    color: var(--gold);
  }
  .price {
    color: var(--gold);
    font-size: var(--fs-small);
  }
  .more {
    margin: 28px 0 0;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--gold);
    font-weight: 500;
    text-underline-offset: 4px;
  }
</style>
