---
// Netlify Forms picks this up from the built HTML. Submissions land in the Netlify
// dashboard under Forms > booking; set an email notification there to the booking inbox.
---

<form class="booking" name="booking" method="POST" data-netlify="true" netlify-honeypot="company">
  <input type="hidden" name="form-name" value="booking" />
  <!-- Honeypot: off-screen, hidden from screen readers, skipped by Tab. Bots fill it, people don't. -->
  <p class="visually-hidden" aria-hidden="true">
    <label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="field">
    <label for="bk-name">Name</label>
    <input id="bk-name" class="input" name="name" autocomplete="name" required />
  </div>
  <div class="field">
    <label for="bk-email">Email</label>
    <input id="bk-email" class="input" type="email" name="email" autocomplete="email" required />
  </div>
  <div class="field">
    <label for="bk-date">Date</label>
    <input id="bk-date" class="input" type="date" name="date" />
  </div>
  <div class="field">
    <label for="bk-venue">Venue or event type</label>
    <input id="bk-venue" class="input" name="venue" placeholder="Bar, wedding, backyard, club" />
  </div>
  <div class="field">
    <label for="bk-budget">Budget</label>
    <input id="bk-budget" class="input" name="budget" />
  </div>
  <div class="field">
    <label for="bk-message">Message</label>
    <textarea id="bk-message" class="input" name="message"></textarea>
  </div>

  <button class="btn btn--primary" type="submit">Send</button>
  <p class="status" role="status" aria-live="polite"></p>
</form>

<script>
  // Submit in place so people stay on the page. Without JS, Netlify's default
  // thank-you page handles it.
  const form = document.querySelector<HTMLFormElement>('form.booking');
  form?.addEventListener('submit', async (e) => {
    if (!form.reportValidity()) return;
    e.preventDefault();
    const status = form.querySelector('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    button.disabled = true;
    status.textContent = 'Sending…';
    try {
      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = 'Got it. We’ll get back to you within a day.';
    } catch {
      status.textContent = 'That didn’t go through. Try again, or email us directly.';
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .booking {
    display: grid;
    gap: 16px;
  }
  button {
    justify-self: start;
    min-width: 160px;
  }
  button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .status {
    margin: 0;
    color: var(--cream);
    font-weight: 500;
  }
  .status:empty {
    display: none;
  }
</style>
