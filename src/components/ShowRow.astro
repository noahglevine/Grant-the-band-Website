---
import { formatDateParts, formatTime, type Show } from '../lib/shows';

interface Props {
  show: Show;
  utm?: string;
}
const { show, utm } = Astro.props;
const d = formatDateParts(show.date);
const time = formatTime(show.time);
const href = show.url && utm ? `${show.url}${show.url.includes('?') ? '&' : '?'}${utm}` : show.url;
---

<li class="show">
  <time class="date" datetime={show.date}>
    <span class="dow">{d.weekday}</span>
    <span class="mon">{d.month}</span>
    <span class="day">{d.day}</span>
  </time>
  <div class="info">
    <p class="venue">{show.venue}</p>
    <p class="meta">{show.town}{time && ` · ${time}`}</p>
  </div>
  {href && (
    <a class="btn btn--secondary details" href={href} rel="noopener" aria-label={`Details: ${show.venue}, ${d.long}`}>
      Details
    </a>
  )}
</li>

<style>
  .show {
    display: grid;
    grid-template-columns: 72px 1fr;
    grid-template-areas: 'date info' 'date cta';
    gap: 4px 16px;
    align-items: center;
    padding-block: 18px;
    border-top: 1px solid var(--line);
  }
  .date {
    grid-area: date;
    display: grid;
    justify-items: start;
    line-height: 1;
  }
  .dow,
  .mon {
    font-size: var(--fs-min);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .dow {
    color: var(--muted);
  }
  .mon {
    margin-top: 4px;
    color: var(--accent);
  }
  .day {
    font-size: 2.5rem;
    font-weight: 900;
    font-stretch: 125%;
    color: var(--text);
  }
  .info {
    grid-area: info;
  }
  .venue {
    margin: 0;
    color: var(--text);
    font-size: var(--fs-row);
    font-weight: 700;
    line-height: 1.25;
  }
  .meta {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: var(--fs-small);
  }
  .details {
    grid-area: cta;
    justify-self: start;
    margin-top: 8px;
  }
  @media (min-width: 720px) {
    .show {
      grid-template-columns: 96px 1fr auto;
      grid-template-areas: 'date info cta';
      padding-block: 22px;
    }
    .details {
      margin-top: 0;
    }
  }
</style>
