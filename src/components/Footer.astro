---
import Wordmark from './Wordmark.astro';
import BookingEmail from './BookingEmail.astro';
import { links } from '../data/site';

const social = [
  { label: 'Instagram', href: links.instagram },
  { label: 'Spotify', href: links.spotify },
  { label: 'YouTube', href: links.youtube },
  { label: 'TikTok', href: links.tiktok },
];
---

<footer class="site-footer">
  <div class="wrap inner">
    <Wordmark size="lg" />
    <ul class="social">
      {social.map((s) => (
        <li><a href={s.href} rel="noopener">{s.label}</a></li>
      ))}
    </ul>
    <p class="booking">Booking: <BookingEmail /></p>
    <p class="legal">© 2026 GRANT the band</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 56px 40px;
  }
  .inner {
    display: grid;
    justify-items: start;
    gap: 20px;
  }
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-right: 12px;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .social a:hover {
    color: var(--accent);
  }
  .booking {
    margin: 0;
    color: var(--body);
  }
  .booking :global(a) {
    color: var(--accent);
    font-weight: 600;
  }
  .legal {
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-small);
  }
</style>
