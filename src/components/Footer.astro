---
import Wordmark from './Wordmark.astro';
import BookingEmail from './BookingEmail.astro';
import { links } from '../data/site';

const social = [
  { label: 'Instagram', href: links.instagram },
  { label: 'Spotify', href: links.spotify },
  { label: 'YouTube', href: links.youtube },
  { label: 'TikTok', href: links.tiktok },
];
---

<footer class="site-footer">
  <div class="wrap inner">
    <div class="brand">
      <Wordmark size="lg" />
      <p class="booking">Booking: <BookingEmail /></p>
    </div>
    <ul class="social">
      {social.map((s) => (
        <li><a href={s.href} rel="noopener">{s.label}</a></li>
      ))}
    </ul>
    <p class="legal">© 2026 GRANT the band · Long Island, NY</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 56px 40px;
  }
  .inner {
    display: grid;
    gap: 24px;
  }
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .brand {
    display: grid;
    gap: 12px;
  }
  .booking {
    margin: 0;
    color: var(--body);
    font-size: var(--fs-small);
  }
  .booking :global(a) {
    color: var(--accent);
    font-weight: 600;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-right: 12px;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .social a:hover {
    color: var(--accent);
  }
  .legal {
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-small);
  }
  @media (min-width: 720px) {
    .inner {
      grid-template-columns: auto 1fr;
      align-items: center;
    }
    .social {
      justify-content: flex-end;
    }
    .legal {
      grid-column: 1 / -1;
    }
  }
</style>
