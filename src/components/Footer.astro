---
import Wordmark from './Wordmark.astro';
import BookingEmail from './BookingEmail.astro';
import { links, monogramPng, creditsInUse } from '../data/site';

const social = [
  { label: 'Instagram', href: links.instagram },
  { label: 'Spotify', href: links.spotify },
  { label: 'YouTube', href: links.youtube },
  { label: 'TikTok', href: links.tiktok },
];
const credits = creditsInUse();
---

<footer class="site-footer">
  <div class="wrap inner">
    <Wordmark size="lg" />
    <ul class="social">
      {social.map((s) => (
        <li><a href={s.href} rel="noopener">{s.label}</a></li>
      ))}
    </ul>
    <p class="booking">Booking: <BookingEmail /></p>
    {credits.length > 0 && (
      <p class="credits">
        Photos:{' '}
        {credits.map((c, i) => (
          <>{i > 0 && ', '}<a href={c.url} rel="noopener">{c.handle}</a></>
        ))}
      </p>
    )}
    <div class="base">
      <p class="legal">© 2026 GRANT the band</p>
      {monogramPng ? (
        <img class="monogram" src={monogramPng} alt="" width="48" height="48" />
      ) : (
        <span class="monogram-ph" aria-hidden="true">[GTB monogram]</span>
      )}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    padding-block: 56px 40px;
  }
  .inner {
    display: grid;
    justify-items: start;
    gap: 20px;
  }
  /* Phones: 2x2 grid so no link wraps onto a line by itself. */
  .social {
    display: grid;
    grid-template-columns: repeat(2, auto);
    justify-content: start;
    gap: 0 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-right: 12px;
    color: var(--cream);
    font-weight: 500;
    text-decoration: none;
  }
  .social a:hover {
    color: var(--gold);
  }
  @media (min-width: 560px) {
    .social {
      display: flex;
      flex-wrap: wrap;
      gap: 0 8px;
    }
  }
  .booking,
  .credits {
    margin: 0;
    color: var(--cream);
    font-size: var(--fs-small);
  }
  .base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    width: 100%;
  }
  .base > * {
    white-space: nowrap;
  }
  .legal {
    margin: 0;
    color: var(--gold);
    font-size: var(--fs-small);
  }
  .monogram {
    width: 48px;
    height: auto;
  }
  .monogram-ph {
    color: var(--gold);
    font-size: var(--fs-min);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
