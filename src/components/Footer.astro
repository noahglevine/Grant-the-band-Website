---
import Wordmark from './Wordmark.astro';
import BookingEmail from './BookingEmail.astro';
import SocialIcons from './SocialIcons.astro';
import { shopUrl, monogram, creditsInUse, bookingEmail } from '../data/site';

interface Props {
  // The newsletter signup: on the page where there is one, else home's (/book has none).
  signupHref?: string;
}
const { signupHref = '#newsletter' } = Astro.props;
const credits = creditsInUse();
---

<footer class="site-footer">
  <div class="wrap inner">
    <Wordmark size="lg" />
    <SocialIcons />
    <div class="lines">
      {bookingEmail && <p>Booking: <BookingEmail /></p>}
      <p>Merch: <a href={shopUrl} rel="noopener">shop.granttheband.com</a></p>
      <p><a class="signup-link" href={signupHref}>Get the dates first</a></p>
      {credits.length > 0 && (
        <p>
          Photos:{' '}
          {credits.map((c, i) => (
            <>{i > 0 && ', '}<a href={c.url} rel="noopener">{c.handle}</a></>
          ))}
        </p>
      )}
    </div>
    <div class="base">
      <p class="legal">© 2026 GRANT the band</p>
      <a class="top-link" href="#top" aria-label="Back to top"><img class="monogram" src={monogram.svg} alt="" width="56" height="56" /></a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    padding-block: 56px 40px;
  }
  .inner {
    display: grid;
    justify-items: start;
    gap: 20px;
  }
  .lines {
    display: grid;
    gap: 2px;
  }
  .lines p {
    margin: 0;
    color: var(--cream);
    font-size: var(--fs-small);
  }
  /* Every text link here is a 44px target, from padding, without spreading the lines apart. */
  .lines :global(a) {
    display: inline-block;
    padding-block: calc((44px - 1lh) / 2);
    margin-block: calc((1lh - 44px) / 2);
    color: var(--gold);
    text-underline-offset: 4px;
  }
  .lines p {
    padding-block: 10px;
  }
  .signup-link {
    font-weight: 500;
  }
  .base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    width: 100%;
  }
  .base > * {
    white-space: nowrap;
  }
  .legal {
    margin: 0;
    color: var(--gold);
    font-size: var(--fs-small);
  }
  .top-link {
    display: block;
    border-radius: 50%;
  }
  .monogram {
    width: 56px;
    height: 56px;
  }
</style>
