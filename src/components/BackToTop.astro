---
// Back to top: a round outlined button with a cream up-chevron, bottom-right on every page.
// It fades in only once the hero (or, on pages without one, the first screen) has scrolled
// away, and fades out whenever a ticket, a signup form or a footer passes through the strip
// at the bottom of the screen where it sits, so it never covers them. Without JS it never
// shows; the footer monogram still links to the top.
---

<a class="to-top" href="#top" aria-label="Back to top" data-to-top>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 15l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
</a>

<script>
  const btn = document.querySelector<HTMLAnchorElement>('[data-to-top]');
  if (btn) {
    // What the button must never sit on.
    const AVOID = '.ticket, .signup .form, .site-footer, [data-page-end]';
    const hero = document.querySelector<HTMLElement>('.hero');
    let pastHero = false;
    const under = new Set<Element>();
    const update = () => btn.classList.toggle('is-visible', pastHero && under.size === 0);

    const onScroll = () => {
      const fold = hero ? hero.offsetTop + hero.offsetHeight : innerHeight * 0.9;
      const next = scrollY >= fold - 1;
      if (next !== pastHero) {
        pastHero = next;
        update();
      }
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Watch only the bottom strip of the viewport the button occupies (its height, its offset
    // and a little air). Rebuilt on resize because the strip is measured in pixels.
    let io: IntersectionObserver | undefined;
    const watch = () => {
      io?.disconnect();
      under.clear();
      const r = btn.getBoundingClientRect();
      const strip = innerHeight - r.top + 16;
      io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) e.isIntersecting ? under.add(e.target) : under.delete(e.target);
          update();
        },
        { rootMargin: `-${Math.max(0, Math.round(innerHeight - strip))}px 0px 0px 0px` },
      );
      document.querySelectorAll(AVOID).forEach((el) => io!.observe(el));
    };
    watch();
    addEventListener('resize', watch);
  }

  // Every "#top" link (this button and the footer monogram) scrolls up without adding #top to
  // the URL, then moves keyboard focus to the page's H1.
  document.querySelectorAll<HTMLAnchorElement>('a[href="#top"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' });
      const h1 = document.querySelector<HTMLElement>('main h1');
      if (h1) {
        h1.setAttribute('tabindex', '-1');
        h1.focus({ preventScroll: true });
      }
    });
  });
</script>

<style>
  .to-top {
    position: fixed;
    right: var(--gutter);
    bottom: max(16px, calc(env(safe-area-inset-bottom) + 12px));
    z-index: 15;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid var(--cream);
    border-radius: 50%;
    background: rgb(16 21 28 / 0.8);
    color: var(--cream);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 0.25s,
      transform 0.25s,
      visibility 0.25s,
      border-color 0.15s,
      color 0.15s;
  }
  .to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .to-top:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  @media (prefers-reduced-motion: reduce) {
    .to-top {
      transition: none;
    }
  }
</style>
